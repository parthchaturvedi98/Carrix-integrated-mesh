# Copy to .env and fill in to use the real Anthropic API.
# If ANTHROPIC_API_KEY is empty/absent, the demo runs in deterministic FALLBACK mode
# (no network calls to Claude) so it always runs end-to-end.
ANTHROPIC_API_KEY=

# Optional model overrides (defaults are sensible current models).
# CARRIX_ORCHESTRATOR_MODEL=claude-opus-4-8
# CARRIX_WORKER_MODEL=claude-sonnet-4-6

# Optional: point adapters at different base URLs (e.g. a real system later).
# CARRIX_MOCK_BASE=http://127.0.0.1:8000
